# PostgreSQL Database URL
# Make sure PostgreSQL is running and pgvector extension is installed
# To install pgvector, run: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL="postgresql://user:password@localhost:5432/anatomy_app?schema=public"

# Server Configuration
NODE_ENV="development"
PORT=3000

# OpenAI API Key
OPENAI_API_KEY="Your_OpenAI_API_Key_Here"