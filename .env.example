# PostgreSQL Database URL
# Make sure PostgreSQL is running and pgvector extension is installed
# To install pgvector, run: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anatomy_app?schema=public"

# Server Configuration
NODE_ENV="development"
PORT=3000

# OpenAI API Key
OPENAI_API_KEY="sk-your-key-here"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Optional: LangSmith API Key for tracing
LANGSMITH_API_KEY=""

# Optional: Log level
LOG_LEVEL="info"