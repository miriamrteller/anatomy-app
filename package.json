{
  "name": "anatomy-app",
  "version": "1.0.0",
  "description": "Anatomy structures API with vector embeddings",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "eval": "tsx scripts/run-eval.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "embed": "tsx scripts/embed-structures.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "check-svg-ids": "tsx scripts/check-svg-ids.ts",
    "extract-svg-paths": "tsx scripts/extract-svg-paths.ts",
    "fetch-anatomy": "tsx scripts/fetch-anatomical-data.ts",
    "generate-bones": "tsx scripts/svg-utils/generate-bones-from-svgs.ts",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate && npm run seed",
    "db:connect": "psql -U postgres -d anatomy_app",
    "db:init": "npm run db:setup && npm run db:connect"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.5.12",
    "helmet": "^7.1.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^29.0.2",
    "openai": "^4.52.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.19.39",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
